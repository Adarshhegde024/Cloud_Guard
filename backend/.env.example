# Generate independent random values before any non-demo deployment:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CLOUDGUARD_JWT_SECRET=replace-with-a-long-random-secret
# Base64 encoding of exactly 32 random bytes. Keep this key private and backed up.
CLOUDGUARD_FILE_KEY=replace-with-base64-encoded-32-byte-key
CLOUDGUARD_DATABASE=cloudguard.db
CLOUDGUARD_ENV=development
CLOUDGUARD_WHISPER_MODEL=tiny.en
CLOUDGUARD_DEEPFACE_ENGINE=tensorflow
# Resend invitation email. Use an API key with sending access and a verified sender/domain.
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL=CloudGuard <invitations@example.com>
# Public frontend origin where invitees can open the single-use claim link.
CLOUDGUARD_APP_URL=https://app.example.com
# Optional, separately authenticated reviewer portal.
# CLOUDGUARD_REVIEWER_EMAIL=reviewer@example.com
# Generate a bcrypt hash with the command documented in README.md.
# CLOUDGUARD_REVIEWER_PASSWORD_HASH=replace-with-bcrypt-hash
